<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Nehdo - Reset Password</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f5f3;
            color: #171717;
            min-height: 100vh
        }

        .page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 48% 52%
        }

        .left {
            background: #171717;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 55px 8%;
            position: relative;
            overflow: hidden
        }

        .left:before,
        .left:after {
            content: "";
            position: absolute;
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 50%
        }

        .left:before {
            width: 500px;
            height: 500px;
            right: -230px;
            top: -160px
        }

        .left:after {
            width: 380px;
            height: 380px;
            left: -210px;
            bottom: -150px
        }

        .logo img {
            width: 120px;
            max-height: 55px;
            object-fit: contain;
            filter: brightness(0) invert(1)
        }

        .brand {
            position: relative;
            z-index: 1;
            max-width: 470px;
            margin: auto 0
        }

        .tag {
            font-size: 12px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #aaa;
            margin-bottom: 20px
        }

        .brand h1 {
            font-size: 52px;
            line-height: 1.08;
            font-weight: 500;
            margin-bottom: 22px
        }

        .brand p {
            font-size: 16px;
            line-height: 1.8;
            color: #aaa;
            max-width: 410px
        }

        .features {
            display: flex;
            gap: 28px;
            margin-top: 40px
        }

        .feature {
            font-size: 12px;
            color: #aaa
        }

        .feature strong {
            display: block;
            color: #fff;
            font-size: 13px;
            margin-bottom: 6px
        }

        .bottom {
            font-size: 12px;
            color: #777;
            position: relative;
            z-index: 1
        }

        .right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 9%;
            background: #fff
        }

        .form-wrap {
            width: 100%;
            max-width: 470px
        }

        .form-head {
            margin-bottom: 32px
        }

        .form-head h2 {
            font-size: 32px;
            font-weight: 500;
            margin-bottom: 10px
        }

        .form-head p {
            font-size: 14px;
            color: #777;
            line-height: 1.7
        }

        .form-group {
            margin-bottom: 20px
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 9px
        }

        input {
            width: 100%;
            height: 52px;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 0 15px;
            font-size: 14px;
            outline: none;
            background: #fafafa;
            transition: .2s
        }

        input:focus {
            border-color: #171717;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(0, 0, 0, .04)
        }

        button {
            width: 100%;
            height: 52px;
            border: 0;
            border-radius: 8px;
            background: #171717;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 5px;
            transition: .2s
        }

        button:hover {
            background: #333
        }

        .note {
            text-align: center;
            color: #999;
            font-size: 12px;
            margin-top: 18px
        }

        .message {
            text-align: center;
            max-width: 430px;
            margin: auto
        }

        .icon {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin: 0 auto 22px
        }

        .success .icon {
            background: #edf8f0;
            color: #188544
        }

        .error .icon,
        .expired .icon {
            background: #fff0f0;
            color: #d33
        }

        .message h2 {
            font-size: 28px;
            font-weight: 500;
            margin-bottom: 12px
        }

        .message p {
            font-size: 14px;
            color: #777;
            line-height: 1.8
        }

        @media(max-width:800px) {
            .page {
                grid-template-columns: 1fr
            }

            .left {
                min-height: 330px;
                padding: 30px 7%
            }

            .brand {
                margin: 45px 0 20px
            }

            .brand h1 {
                font-size: 38px
            }

            .brand p {
                font-size: 14px
            }

            .features {
                margin-top: 25px;
                gap: 20px
            }

            .bottom {
                display: none
            }

            .right {
                padding: 45px 7%;
                min-height: calc(100vh - 330px)
            }
        }

        @media(max-width:480px) {
            .left {
                min-height: 300px
            }

            .brand h1 {
                font-size: 32px
            }

            .features {
                display: none
            }

            .right {
                padding: 35px 22px
            }

            .form-head h2 {
                font-size: 27px
            }
        }
    </style>
</head>

<body>
    <div class="page">

        <section class="left">
            <div class="logo">
                <img src="/uploads/logo/nehdo-logo.png" alt="Nehdo">
            </div>

            <div class="brand">
                <div class="tag">Welcome back</div>
                <h1>Secure your account with a new password.</h1>
                <p>Keep your account protected with a strong and secure password. You're just one step away.</p>

                <div class="features">
                    <div class="feature"><strong>Secure</strong>Protected account</div>
                    <div class="feature"><strong>Simple</strong>Easy password reset</div>
                    <div class="feature"><strong>Private</strong>Your data stays safe</div>
                </div>
            </div>

            <div class="bottom">© <%= new Date().getFullYear() %> Nehdo</div>
        </section>

        <section class="right">
            <div class="form-wrap">

                <% if(type==="success" ){ %>
                    <div class="message success">
                        <div class="icon">✓</div>
                        <h2>Password Updated</h2>
                        <p>Your password has been successfully updated. You can now login with your new password.</p>
                    </div>

                    <% }else if(type==="expired" ){ %>
                        <div class="message expired">
                            <div class="icon">!</div>
                            <h2>Link Expired</h2>
                            <p>Your password reset link has expired. Please request a new password reset link.</p>
                        </div>

                        <% }else if(type==="error" ){ %>
                            <div class="message error">
                                <div class="icon">×</div>
                                <h2>Invalid Link</h2>
                                <p>This password reset link is invalid or no longer available.</p>
                            </div>

                            <% }else{ %>
                                <div class="form-head">
                                    <h2>Reset Password</h2>
                                    <p>Create a new password for your Nehdo account. Make sure your password is at least
                                        6 characters long.</p>
                                </div>

                                <form id="resetForm" action="/api/v1/user/auth/reset-password/<%= token %>"
                                    method="POST">

                                    <div class="form-group">
                                        <label for="password">New Password</label>
                                        <input id="password" type="password" name="password"
                                            placeholder="Enter your new password" minlength="6" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="confirmPassword">Confirm Password</label>
                                        <input id="confirmPassword" type="password" name="confirmPassword"
                                            placeholder="Re-enter your new password" minlength="6" required>
                                    </div>

                                    <button type="submit">Update Password</button>
                                    <p class="note">Your password will be securely encrypted.</p>
                                </form>
                                <% } %>
            </div>
        </section>

    </div>

    <script>
        document.getElementById("resetForm")?.addEventListener("submit", function (e) {
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;
            if (password !== confirmPassword) {
                e.preventDefault();
                alert("Passwords do not match");
            }
        });
    </script>
</body>

</html>